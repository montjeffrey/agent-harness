{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/graph_read_guard.py"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/claim_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/harness/graph_check.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/memory_context_hook.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/progress_capture_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/handoff_capture_hook.py",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/progress_capture_hook.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "<python> <harness>/hooks/claude/handoff_capture_hook.py",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
